# Copia este archivo a .env y ajusta los valores. NUNCA subas .env al repo.
DEBUG=True
SECRET_KEY=cambia-esto-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Vacío = usa SQLite (desarrollo). En producción: postgres://user:pass@host:5432/sst
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Limite de peticiones (TS25). Formato DRF: numero/periodo (s, min, hour, day).
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=10/min
# Nivel de los registros JSON de cada peticion (TS23).
LOG_LEVEL=INFO
THROTTLE_CLIENT_ERRORS=30/min
# Correo transaccional (TS19). Sin EMAIL_BACKEND, los correos salen por consola.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Resguardo <no-responder@resguardo.pe>
FRONTEND_URL=http://localhost:5173
